# Payment configuration for the donate pages. Copy to .env.local (ignored by git) and rebuild.
# Public key only, inlined into the static build; the secret key never belongs here.
# Until the key is set, the page shows the gift and asks donors to write to the foundation.

# Paystack public key: Paystack Dashboard > Settings > API Keys & Webhooks
# (pk_test_... while testing, pk_live_... to go live).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Currencies the foundation's Paystack account may charge, comma-separated, first is the default.
# The account charges US dollars. Another currency also needs a rate in donate.rates in data/data.json.
NEXT_PUBLIC_PAYSTACK_CURRENCIES=USD

# Contact form: the URL of the function that sends the mail through Resend (see server/contact/README.md).
# Default /api/contact: where the Vercel adapter deploys and where netlify.toml routes the Netlify one.
# Set a full URL for a Cloudflare Worker or any other host.
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact

# The function itself (never the site) needs: RESEND_API_KEY, CONTACT_TO, CONTACT_FROM and optionally ALLOWED_ORIGINS.
